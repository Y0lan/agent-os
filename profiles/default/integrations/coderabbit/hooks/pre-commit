#!/usr/bin/env bash

# =============================================================================
# Agent-OS Pre-Commit Hook
# Runs CodeRabbit CLI review before allowing commits
# =============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored messages
print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_header() {
    echo ""
    echo -e "${BLUE}════════════════════════════════════════════${NC}"
    echo -e "${BLUE}  Agent-OS Pre-Commit Code Review${NC}"
    echo -e "${BLUE}════════════════════════════════════════════${NC}"
    echo ""
}

# Check for cached comprehensive review
if [ -f "agent-os/code-reviews/.all-agents-reviewed" ]; then
    print_header
    print_success "Code already reviewed in comprehensive review"
    print_info "All agents completed individual scoped reviews"
    print_info "Comprehensive integration review passed"
    print_info "Skipping redundant pre-commit review"
    echo ""
    print_info "Recent reviews:"
    ls -lt agent-os/code-reviews/*.txt 2>/dev/null | head -3 | while read -r line; do
        echo "    $(echo "$line" | awk '{print $9, $6, $7, $8}')"
    done
    echo ""
    print_success "Pre-commit check passed (using cached reviews)"
    exit 0
fi

# Check if CodeRabbit CLI is installed
if ! command -v coderabbit &> /dev/null && ! command -v cr &> /dev/null; then
    print_header
    print_error "CodeRabbit CLI is not installed"
    echo ""
    print_info "Agent-OS requires CodeRabbit CLI for pre-commit code reviews."
    print_info "Install it with:"
    echo "      curl -fsSL https://cli.coderabbit.ai/install.sh | sh"
    echo ""
    print_info "Then reload your shell and try again:"
    echo "      source ~/.zshrc  # or ~/.bashrc"
    echo ""
    print_info "For detailed setup: agent-os/standards/global/coderabbit-setup.md"
    echo ""
    exit 1
fi

# Use 'coderabbit' or 'cr' alias
CODERABBIT_CMD="coderabbit"
if ! command -v coderabbit &> /dev/null; then
    CODERABBIT_CMD="cr"
fi

# Check if CodeRabbit is authenticated
AUTH_STATUS=$($CODERABBIT_CMD auth status 2>&1 || echo "not authenticated")
if ! echo "$AUTH_STATUS" | grep -q "Authenticated\|authenticated\|Logged in"; then
    print_header
    print_error "CodeRabbit CLI is not authenticated"
    echo ""
    print_info "Please authenticate CodeRabbit:"
    echo "      $CODERABBIT_CMD auth login"
    echo ""
    print_info "This will open your browser to complete authentication."
    echo ""
    exit 1
fi

print_header

# Check if there are staged changes to review
STAGED_FILES=$(git diff --cached --name-only)
if [ -z "$STAGED_FILES" ]; then
    print_warning "No staged changes to review"
    echo ""
    print_info "Use 'git add' to stage files before committing."
    echo ""
    exit 0
fi

# Count staged files
STAGED_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
echo "Reviewing $STAGED_COUNT staged file(s)..."
echo ""

# Get staged diff stats
DIFF_STATS=$(git diff --cached --stat)
echo "$DIFF_STATS"
echo ""

# Estimate review time
# Sum additions and deletions from numstat, treating "-" as 0
LINES_CHANGED=$(git diff --cached --numstat | awk '{
    add = ($1 == "-" ? 0 : $1);
    del = ($2 == "-" ? 0 : $2);
    total += add + del
} END {
    print (total == "" ? 0 : total)
}')
# Default to 0 if empty or non-numeric
LINES_CHANGED=${LINES_CHANGED:-0}
ESTIMATED_TIME="7-15 minutes"
if [ "$LINES_CHANGED" -gt 500 ]; then
    ESTIMATED_TIME="30-60 minutes"
elif [ "$LINES_CHANGED" -gt 100 ]; then
    ESTIMATED_TIME="15-30 minutes"
fi

print_info "Estimated review time: $ESTIMATED_TIME"
echo ""

# Run CodeRabbit review
print_info "Running CodeRabbit code review..."
echo ""

# Create a temporary file for the review output
REVIEW_OUTPUT=$(mktemp)
trap "rm -f $REVIEW_OUTPUT" EXIT

# Run CodeRabbit and capture output
if ! $CODERABBIT_CMD --prompt-only --type uncommitted > "$REVIEW_OUTPUT" 2>&1; then
    print_error "CodeRabbit review failed"
    echo ""
    cat "$REVIEW_OUTPUT"
    echo ""

    # Check for common errors
    if grep -q "rate limit" "$REVIEW_OUTPUT"; then
        print_warning "Rate limit exceeded. Wait for reset or upgrade your plan."
        print_info "Visit: https://coderabbit.ai/pricing"
    elif grep -q "authentication" "$REVIEW_OUTPUT"; then
        print_warning "Authentication error. Please re-authenticate:"
        echo "      $CODERABBIT_CMD auth login"
    elif grep -q "network\|timeout\|connection" "$REVIEW_OUTPUT"; then
        print_warning "Network error. Check your internet connection and try again."
    fi

    echo ""
    print_info "To skip this check and commit anyway (NOT RECOMMENDED):"
    echo "      git commit --no-verify"
    echo ""
    exit 1
fi

# Parse review results
echo ""
print_info "Analyzing review results..."
echo ""

# Extract issue counts by severity (grep -c returns 0 if no matches, so we don't need || echo)
CRITICAL_COUNT=$(grep -c "\[CRITICAL\]" "$REVIEW_OUTPUT" 2>/dev/null) || CRITICAL_COUNT=0
HIGH_COUNT=$(grep -c "\[HIGH\]" "$REVIEW_OUTPUT" 2>/dev/null) || HIGH_COUNT=0
MEDIUM_COUNT=$(grep -c "\[MEDIUM\]" "$REVIEW_OUTPUT" 2>/dev/null) || MEDIUM_COUNT=0
LOW_COUNT=$(grep -c "\[LOW\]" "$REVIEW_OUTPUT" 2>/dev/null) || LOW_COUNT=0

# Strip any whitespace
CRITICAL_COUNT=$(echo "$CRITICAL_COUNT" | tr -d '[:space:]')
HIGH_COUNT=$(echo "$HIGH_COUNT" | tr -d '[:space:]')
MEDIUM_COUNT=$(echo "$MEDIUM_COUNT" | tr -d '[:space:]')
LOW_COUNT=$(echo "$LOW_COUNT" | tr -d '[:space:]')

# Final validation - ensure they're positive integers
[[ ! "$CRITICAL_COUNT" =~ ^[0-9]+$ ]] && CRITICAL_COUNT=0
[[ ! "$HIGH_COUNT" =~ ^[0-9]+$ ]] && HIGH_COUNT=0
[[ ! "$MEDIUM_COUNT" =~ ^[0-9]+$ ]] && MEDIUM_COUNT=0
[[ ! "$LOW_COUNT" =~ ^[0-9]+$ ]] && LOW_COUNT=0

TOTAL_ISSUES=$((CRITICAL_COUNT + HIGH_COUNT + MEDIUM_COUNT + LOW_COUNT))

# Display results
echo "════════════════════════════════════════════"
echo "  Review Summary"
echo "════════════════════════════════════════════"
echo ""
echo "  🔴 Critical: $CRITICAL_COUNT"
echo "  🟠 High:     $HIGH_COUNT"
echo "  🟡 Medium:   $MEDIUM_COUNT"
echo "  🟢 Low:      $LOW_COUNT"
echo ""
echo "  Total Issues: $TOTAL_ISSUES"
echo ""
echo "════════════════════════════════════════════"
echo ""

# If critical or high priority issues found, block commit
if [ "$CRITICAL_COUNT" -gt 0 ] || [ "$HIGH_COUNT" -gt 0 ]; then
    print_error "Commit blocked: Critical or high-priority issues found"
    echo ""

    if [ "$CRITICAL_COUNT" -gt 0 ]; then
        echo "🔴 CRITICAL ISSUES:"
        echo ""
        grep -A 3 "\[CRITICAL\]" "$REVIEW_OUTPUT" || true
        echo ""
    fi

    if [ "$HIGH_COUNT" -gt 0 ]; then
        echo "🟠 HIGH PRIORITY ISSUES:"
        echo ""
        grep -A 3 "\[HIGH\]" "$REVIEW_OUTPUT" || true
        echo ""
    fi

    echo "════════════════════════════════════════════"
    echo ""
    print_warning "Please fix these issues before committing."
    echo ""
    print_info "To see full review output:"
    echo "      $CODERABBIT_CMD --plain --type uncommitted"
    echo ""
    print_info "To fix issues and run review again:"
    echo "      [Fix the issues in your editor]"
    echo "      git add [files]"
    echo "      git commit"
    echo ""
    print_info "To skip this check (NOT RECOMMENDED):"
    echo "      git commit --no-verify"
    echo ""

    # Save review report for reference
    REPORT_DIR="agent-os/code-reviews"
    mkdir -p "$REPORT_DIR"
    REPORT_FILE="$REPORT_DIR/pre-commit-blocked-$(date +%Y%m%d-%H%M%S).md"
    cat "$REVIEW_OUTPUT" > "$REPORT_FILE"
    print_info "Full review saved to: $REPORT_FILE"
    echo ""

    exit 1
fi

# If only medium/low issues, allow commit with warning
if [ "$TOTAL_ISSUES" -gt 0 ]; then
    print_warning "Medium/low priority issues found, but commit allowed"
    echo ""

    if [ "$MEDIUM_COUNT" -gt 0 ]; then
        echo "🟡 Medium priority issues:"
        grep "\[MEDIUM\]" "$REVIEW_OUTPUT" | head -3 || true
        if [ "$MEDIUM_COUNT" -gt 3 ]; then
            echo "   ... and $((MEDIUM_COUNT - 3)) more"
        fi
        echo ""
    fi

    if [ "$LOW_COUNT" -gt 0 ]; then
        print_info "$LOW_COUNT low priority issues (style, formatting)"
    fi

    echo ""
    print_info "Consider addressing these issues in a future commit."
    echo ""

    # Save review report
    REPORT_DIR="agent-os/code-reviews"
    mkdir -p "$REPORT_DIR"
    REPORT_FILE="$REPORT_DIR/pre-commit-warnings-$(date +%Y%m%d-%H%M%S).md"
    cat "$REVIEW_OUTPUT" > "$REPORT_FILE"
    print_info "Full review saved to: $REPORT_FILE"
    echo ""
fi

# No issues found
if [ "$TOTAL_ISSUES" -eq 0 ]; then
    print_success "No issues found! Code quality verified."
    echo ""
    print_info "Your changes are ready to commit."
    echo ""
fi

print_success "Pre-commit review passed"
echo ""

exit 0
